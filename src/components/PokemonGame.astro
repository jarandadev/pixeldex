---
---
<div class="relative flex flex-col items-center w-full max-w-2xl mx-auto p-6">
    <!-- Scoreboard -->
    <div class="w-full flex justify-between items-center mb-6 px-4 py-3 bg-slate-800 border-4 border-slate-900 shadow-[4px_4px_0px_0px_rgba(0,0,0,0.5)]">
        <div class="flex flex-col items-center">
            <span class="text-xs uppercase tracking-wider text-slate-400 font-mono font-bold mb-1">Racha</span>
            <span id="current-streak" class="text-2xl font-mono text-white">0</span>
        </div>
        <div class="flex flex-col items-center">
            <span class="text-xs uppercase tracking-wider text-slate-400 font-mono font-bold mb-1">Récord</span>
            <span id="record-streak" class="text-2xl font-mono text-yellow-500">0</span>
        </div>
    </div>

    <!-- Settings Controls -->
    <div class="w-full flex flex-col sm:flex-row justify-between items-center mb-6 gap-4 z-40">
        <!-- Region Multi-Selector -->
        <div class="relative w-full sm:w-auto group" id="gen-dropdown-container">
            <button id="gen-dropdown-btn" class="w-full sm:w-64 bg-slate-800 text-white font-mono text-sm px-4 py-2 border-4 border-slate-900 shadow-[4px_4px_0px_0px_rgba(0,0,0,0.5)] flex justify-between items-center hover:bg-slate-700 transition-colors">
                <span>Generaciones (Todas)</span>
                <span class="text-slate-400">▼</span>
            </button>
            <!-- Dropdown Menu -->
            <div id="gen-dropdown-menu" class="absolute top-full left-0 w-full sm:w-64 bg-slate-800 border-4 border-slate-900 max-h-60 overflow-y-auto hidden shadow-xl mt-1">
                <div class="p-2 space-y-1">
                    <label class="flex items-center space-x-3 p-2 hover:bg-slate-700 cursor-pointer text-white font-mono text-xs">
                        <input type="checkbox" value="gen1" checked class="form-checkbox h-4 w-4 text-blue-600 bg-slate-900 border-slate-600 rounded focus:ring-0 focus:ring-offset-0">
                        <span>Gen 1 (Kanto)</span>
                    </label>
                    <label class="flex items-center space-x-3 p-2 hover:bg-slate-700 cursor-pointer text-white font-mono text-xs">
                        <input type="checkbox" value="gen2" checked class="form-checkbox h-4 w-4 text-blue-600 bg-slate-900 border-slate-600 rounded focus:ring-0 focus:ring-offset-0">
                        <span>Gen 2 (Johto)</span>
                    </label>
                    <label class="flex items-center space-x-3 p-2 hover:bg-slate-700 cursor-pointer text-white font-mono text-xs">
                        <input type="checkbox" value="gen3" checked class="form-checkbox h-4 w-4 text-blue-600 bg-slate-900 border-slate-600 rounded focus:ring-0 focus:ring-offset-0">
                        <span>Gen 3 (Hoenn)</span>
                    </label>
                    <label class="flex items-center space-x-3 p-2 hover:bg-slate-700 cursor-pointer text-white font-mono text-xs">
                        <input type="checkbox" value="gen4" checked class="form-checkbox h-4 w-4 text-blue-600 bg-slate-900 border-slate-600 rounded focus:ring-0 focus:ring-offset-0">
                        <span>Gen 4 (Sinnoh)</span>
                    </label>
                    <label class="flex items-center space-x-3 p-2 hover:bg-slate-700 cursor-pointer text-white font-mono text-xs">
                        <input type="checkbox" value="gen5" checked class="form-checkbox h-4 w-4 text-blue-600 bg-slate-900 border-slate-600 rounded focus:ring-0 focus:ring-offset-0">
                        <span>Gen 5 (Unova)</span>
                    </label>
                    <label class="flex items-center space-x-3 p-2 hover:bg-slate-700 cursor-pointer text-white font-mono text-xs">
                        <input type="checkbox" value="gen6" checked class="form-checkbox h-4 w-4 text-blue-600 bg-slate-900 border-slate-600 rounded focus:ring-0 focus:ring-offset-0">
                        <span>Gen 6 (Kalos)</span>
                    </label>
                    <label class="flex items-center space-x-3 p-2 hover:bg-slate-700 cursor-pointer text-white font-mono text-xs">
                        <input type="checkbox" value="gen7" checked class="form-checkbox h-4 w-4 text-blue-600 bg-slate-900 border-slate-600 rounded focus:ring-0 focus:ring-offset-0">
                        <span>Gen 7 (Alola)</span>
                    </label>
                    <label class="flex items-center space-x-3 p-2 hover:bg-slate-700 cursor-pointer text-white font-mono text-xs">
                        <input type="checkbox" value="gen8" checked class="form-checkbox h-4 w-4 text-blue-600 bg-slate-900 border-slate-600 rounded focus:ring-0 focus:ring-offset-0">
                        <span>Gen 8 (Galar)</span>
                    </label>
                    <label class="flex items-center space-x-3 p-2 hover:bg-slate-700 cursor-pointer text-white font-mono text-xs">
                        <input type="checkbox" value="gen9" checked class="form-checkbox h-4 w-4 text-blue-600 bg-slate-900 border-slate-600 rounded focus:ring-0 focus:ring-offset-0">
                        <span>Gen 9 (Paldea)</span>
                    </label>
                </div>
            </div>
        </div>

        <!-- Shiny Toggle -->
        <button id="shiny-toggle" class="w-full sm:w-auto flex items-center justify-center gap-3 px-4 py-2 bg-slate-800 border-4 border-slate-900 shadow-[4px_4px_0px_0px_rgba(0,0,0,0.5)] active:translate-y-1 active:shadow-none transition-all group hover:bg-slate-700">
            <span class="text-white font-mono text-sm font-bold uppercase">Shiny (50%)</span>
            <div class="relative w-12 h-6 bg-slate-900 rounded-full border-2 border-slate-600 transition-colors group-[.is-active]:bg-purple-900 group-[.is-active]:border-purple-600">
                <div class="absolute top-1/2 -translate-y-1/2 left-1 w-4 h-4 bg-slate-400 rounded-full transition-all group-[.is-active]:left-6 group-[.is-active]:bg-purple-400 shadow-sm"></div>
            </div>
        </button>
    </div>

    <!-- Game Area -->
    <div class="relative group w-full flex justify-center mb-8">
        <div id="game-card" class="relative bg-slate-200 p-2 border-4 border-slate-900 shadow-[8px_8px_0px_0px_rgba(0,0,0,0.2)] transition-colors duration-300">
            <!-- Grid Background Container -->
            <div class="absolute inset-2 z-0 overflow-hidden bg-slate-100">
                <div class="retro-grid w-full h-full absolute inset-0"></div>
            </div>

            <canvas id="game-canvas" width="300" height="300" class="relative z-10 image-pixelated"></canvas>
            
            <!-- Loading Overlay -->
            <div id="loading-overlay" class="absolute inset-2 flex items-center justify-center bg-slate-900 z-20">
                <div class="flex flex-col items-center gap-4">
                    <div class="w-12 h-12 border-4 border-slate-200 border-t-slate-900 animate-spin"></div>
                    <span class="text-slate-200 font-mono text-sm uppercase tracking-widest animate-pulse">Cargando...</span>
                </div>
            </div>

            <!-- Feedback Overlay (Correct/Wrong) -->
            <div id="feedback-overlay" class="absolute inset-2 flex items-end justify-center pb-6 z-30 pointer-events-none hidden">
                <span id="feedback-text" class="text-2xl font-mono font-bold text-white px-4 py-2 bg-slate-900 border-2 border-white shadow-[4px_4px_0px_0px_#000]"></span>
            </div>
            
            <!-- Shiny Indicator on reveal -->
            <div id="shiny-indicator" class="hidden absolute top-4 right-4 z-10">
                <svg class="w-8 h-8 text-yellow-500 drop-shadow-md animate-bounce" fill="currentColor" viewBox="0 0 24 24"> <!-- Bigger shiny star -->
                   <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
            </div>
        </div>
    </div>

    <!-- Controls -->
    <div class="w-full flex flex-col gap-4">
        <div class="relative w-full group">
            <div class="relative flex gap-2">
                <input 
                    type="text" 
                    id="guess-input" 
                    class="flex-1 bg-slate-800 text-white px-4 py-3 outline-none font-mono text-sm border-4 border-slate-900 placeholder-slate-500 focus:bg-slate-900 transition-colors" 
                    placeholder="NOMBRE DEL POKÉMON..." 
                    autocomplete="off"
                >
                <button 
                    id="submit-btn" 
                    class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white font-mono font-bold border-4 border-slate-900 shadow-[4px_4px_0px_0px_rgba(0,0,0,0.5)] active:translate-y-1 active:shadow-none transition-all"
                >
                    ADIVINAR
                </button>
            </div>
            
            <!-- Custom Autocomplete Dropdown -->
            <ul id="autocomplete-list" class="absolute w-full bottom-full mb-2 bg-slate-800 border-4 border-slate-900 max-h-60 overflow-y-auto z-50 hidden shadow-[4px_4px_0px_0px_rgba(0,0,0,0.5)]">
                <!-- Items injected via JS -->
            </ul>
        </div>

        <div class="flex justify-between items-center text-sm font-mono font-bold px-1">
            <span id="guesses-text" class="text-slate-400">INTENTOS: 4</span>
            <button 
                id="skip-btn" 
                class="text-slate-500 hover:text-slate-300 transition-colors flex items-center gap-2 uppercase"
            >
                <span>Saltar >></span>
            </button>
        </div>
    </div>
</div>

<style>
    .retro-grid {
        background-size: 40px 40px;
        background-image:
            linear-gradient(to right, rgba(0, 0, 0, 0.05) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(0, 0, 0, 0.05) 1px, transparent 1px);
        animation: moveGrid 4s linear infinite;
    }

    @keyframes moveGrid {
        0% { transform: translate(0, 0); }
        100% { transform: translate(-40px, -40px); }
    }

    .image-pixelated {
        image-rendering: pixelated;
    }

    @keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-5px); }
        75% { transform: translateX(5px); }
    }
    
    .animate-shake {
        animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
    }
    
    /* Scrollbar Styling for Dropdown */
    #autocomplete-list::-webkit-scrollbar,
    #gen-dropdown-menu::-webkit-scrollbar {
        width: 10px;
        background: #1e293b;
    }
    #autocomplete-list::-webkit-scrollbar-thumb,
    #gen-dropdown-menu::-webkit-scrollbar-thumb {
        background: #475569;
        border: 2px solid #1e293b;
    }
</style>

<script>
    const GEN_RANGES = {
        'gen1': { min: 1, max: 151 },
        'gen2': { min: 152, max: 251 },
        'gen3': { min: 252, max: 386 },
        'gen4': { min: 387, max: 493 },
        'gen5': { min: 494, max: 649 },
        'gen6': { min: 650, max: 721 },
        'gen7': { min: 722, max: 809 },
        'gen8': { min: 810, max: 905 },
        'gen9': { min: 906, max: 1025 }
    };

    const DIFFICULTY_LEVELS = [
        { level: 4, resolution: 8, label: "Extremo" },
        { level: 3, resolution: 10, label: "Difícil" },
        { level: 2, resolution: 12, label: "Medio" },
        { level: 1, resolution: 16, label: "Fácil" }
    ];

    // State
    let state = {
        currentPokemon: null,
        currentImg: null,
        currentLevelIndex: 0, 
        isLoading: false,
        streak: 0,
        record: parseInt(localStorage.getItem('pixelguess_record') || '0'),
        pokemonList: [],
        currentMatches: [],
        selectedIndex: -1,
        isRoundActive: true,
        // Settings
        isShinyMode: false, // user preference (50% chance enabled)
        currentRoundIsShiny: false, // actual state of current drawing
        selectedGens: new Set(['gen1', 'gen2', 'gen3', 'gen4', 'gen5', 'gen6', 'gen7', 'gen8', 'gen9'])
    };

    // Elements
    const els = {
        canvas: document.getElementById('game-canvas'),
        input: document.getElementById('guess-input'),
        skipBtn: document.getElementById('skip-btn'),
        submitBtn: document.getElementById('submit-btn'),
        streak: document.getElementById('current-streak'),
        record: document.getElementById('record-streak'),
        loading: document.getElementById('loading-overlay'),
        ul: document.getElementById('autocomplete-list'),
        feedback: document.getElementById('feedback-overlay'),
        feedbackText: document.getElementById('feedback-text'),
        guessesText: document.getElementById('guesses-text'),
        // New Controls
        genBtn: document.getElementById('gen-dropdown-btn'),
        genMenu: document.getElementById('gen-dropdown-menu'),
        checkboxes: document.querySelectorAll('#gen-dropdown-menu input[type="checkbox"]'),
        shinyToggle: document.getElementById('shiny-toggle'),
        shinyIndicator: document.getElementById('shiny-indicator'),
        gameCard: document.getElementById('game-card')
    };

    const ctx = els.canvas.getContext('2d');

    const normalize = (str) => str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
    const capitalize = (s) => s.charAt(0).toUpperCase() + s.slice(1);

    async function init() {
        updateScoreboard();
        
        try {
            const res = await fetch('https://pokeapi.co/api/v2/pokemon?limit=1025');
            const data = await res.json();
            state.pokemonList = data.results.map(p => p.name);
        } catch (e) {
            console.error("Failed to load pokemon list", e);
        }

        startRound();
        
        // Listeners
        els.skipBtn.addEventListener('click', handleSkip);
        els.submitBtn.addEventListener('click', handleSubmit);
        els.input.addEventListener('input', handleInput);
        els.input.addEventListener('keydown', handleKeydown);

        // Close lists from outside
        document.addEventListener('click', (e) => {
            if (e.target !== els.input && e.target !== els.ul) {
                closeAutocomplete();
            }
            // Close gen menu if clicked outside container
            if (!document.getElementById('gen-dropdown-container').contains(e.target)) {
                els.genMenu.classList.add('hidden');
            }
        });

        // Settings Listeners
        els.genBtn.addEventListener('click', () => {
             els.genMenu.classList.toggle('hidden');
        });

        els.checkboxes.forEach(cb => {
            cb.addEventListener('change', (e) => {
                const val = e.target.value;
                if (e.target.checked) {
                    state.selectedGens.add(val);
                } else {
                    state.selectedGens.delete(val);
                }
                
                // Prevent unselecting all
                if (state.selectedGens.size === 0) {
                    e.target.checked = true;
                    state.selectedGens.add(val);
                    return; // Don't trigger reset if we reverted
                }
                
                updateGenButtonText();

                // Reset and new round on change
                state.streak = 0;
                updateScoreboard();
                startRound();
            });
        });

        els.shinyToggle.addEventListener('click', () => {
            state.isShinyMode = !state.isShinyMode;
            // Toggle visual state
            if (state.isShinyMode) {
                els.shinyToggle.classList.add('is-active');
            } else {
                els.shinyToggle.classList.remove('is-active');
            }
            
            // Reset and new round on change
            state.streak = 0;
            updateScoreboard();
            startRound();
        });
    }
    
    function updateGenButtonText() {
        const count = state.selectedGens.size;
        const text = count === 9 ? 'Generaciones (Todas)' : `Generaciones (${count})`;
        els.genBtn.querySelector('span').textContent = text;
    }

    function getRandomPokemonId() {
        // Collect all potential IDs
        let ranges = [];
        state.selectedGens.forEach(gen => {
            if (GEN_RANGES[gen]) {
                ranges.push(GEN_RANGES[gen]);
            }
        });
        
        if (ranges.length === 0) {
            // Fallback (should be prevented by UI but just in case)
            ranges.push(GEN_RANGES['gen1']);
        }

        // Calculate total weight
        const total = ranges.reduce((acc, r) => acc + (r.max - r.min + 1), 0);
        let random = Math.floor(Math.random() * total);
        
        // Find which range allows this random index
        for (const r of ranges) {
            const span = r.max - r.min + 1;
            if (random < span) {
                return r.min + random;
            }
            random -= span;
        }
        return 1; // Fallback
    }

    async function startRound() {
        if (state.isLoading) return;
        state.isLoading = true;
        state.isRoundActive = true;
        
        els.input.value = '';
        els.input.disabled = true;
        els.skipBtn.disabled = true;
        els.submitBtn.disabled = true;
        closeAutocomplete();
        
        els.loading.classList.remove('hidden');
        els.feedback.classList.add('hidden');
        if(els.shinyIndicator) els.shinyIndicator.classList.add('hidden');

        // Reset Card Styles
        if (els.gameCard) {
            els.gameCard.classList.remove('border-green-500', 'border-red-500');
            els.gameCard.classList.add('border-slate-900');
        }
        
        state.currentLevelIndex = 0;
        updateGuessesText();

        const randomId = getRandomPokemonId();
        
        try {
            const res = await fetch(`https://pokeapi.co/api/v2/pokemon/${randomId}`);
            const data = await res.json();

            // Handle Shiny Chance
            // If mode enabled: 50/50. Else: 0%
            let isShinyRound = false;
            
            if (state.isShinyMode) {
                const roll = Math.random();
                isShinyRound = roll < 0.5;
                console.log(`[PixelDex] Shiny Roll: ${roll.toFixed(4)} (< 0.5) -> ${isShinyRound ? 'SHINY' : 'Normal'}`);
            } else {
                console.log('[PixelDex] Shiny Mode: OFF');
            }
            state.currentRoundIsShiny = isShinyRound;

            let imgUrl = data.sprites.other['official-artwork'].front_default || data.sprites.front_default;
            if (state.currentRoundIsShiny) {
                // Try to get shiny art, check if exists
                const shinyUrl = data.sprites.other['official-artwork'].front_shiny || data.sprites.front_shiny;
                if (shinyUrl) {
                    imgUrl = shinyUrl;
                } else {
                    console.warn('[PixelDex] Shiny sprite missing for this Pokemon, reverting to normal.');
                    state.currentRoundIsShiny = false;
                }
            }

            state.currentPokemon = {
                name: data.name,
                imgUrl: imgUrl
            };

            const img = new Image();
            img.crossOrigin = "Anonymous";
            img.src = state.currentPokemon.imgUrl;
            
            await new Promise((resolve, reject) => {
                img.onload = resolve;
                img.onerror = reject;
            });
            
            state.currentImg = img;
            renderLevel();
            
            state.isLoading = false;
            els.loading.classList.add('hidden');
            els.input.disabled = false;
            els.skipBtn.disabled = false;
            els.submitBtn.disabled = false;
            els.input.focus();
            
        } catch (e) {
            console.error(e);
            state.isLoading = false; 
            setTimeout(startRound, 1000);
        }
    }

    function renderLevel() {
        if (!state.currentImg) return;
        
        const diff = DIFFICULTY_LEVELS[state.currentLevelIndex];
        const size = 300;
        
        ctx.imageSmoothingEnabled = false;

        const w = diff.resolution;
        const h = diff.resolution;
        
        const offCanvas = document.createElement('canvas');
        offCanvas.width = w;
        offCanvas.height = h;
        const offCtx = offCanvas.getContext('2d');
        
        offCtx.clearRect(0, 0, w, h);
        offCtx.drawImage(state.currentImg, 0, 0, w, h);
        
        ctx.clearRect(0, 0, size, size);
        ctx.drawImage(offCanvas, 0, 0, w, h, 0, 0, size, size);
    }

    function handleSkip() {
        if (!state.isRoundActive || state.isLoading) return;

        if (state.currentLevelIndex < DIFFICULTY_LEVELS.length - 1) {
            state.currentLevelIndex++;
            renderLevel();
            updateGuessesText();
        } else {
            handleFailure();
        }
    }

    function updateGuessesText() {
        const remaining = DIFFICULTY_LEVELS.length - state.currentLevelIndex;
        if(els.guessesText) els.guessesText.textContent = `Intentos restantes: ${remaining}`;
    }

    function handleInput(e) {
        if (!state.isRoundActive) return;
        const val = e.target.value;
        
        if (!val || val.length < 2) {
            closeAutocomplete();
            return;
        }

        const normVal = normalize(val);
        state.currentMatches = state.pokemonList
            .filter(name => normalize(name).includes(normVal))
            .slice(0, 50);

        if (state.currentMatches.length > 0) {
            state.selectedIndex = -1;
            renderAutocomplete();
            els.ul.classList.remove('hidden');
        } else {
            closeAutocomplete();
        }
    }

    function renderAutocomplete() {
        els.ul.innerHTML = '';
        state.currentMatches.forEach((match, index) => {
            const li = document.createElement('li');
            const isSelected = index === state.selectedIndex;
            
            li.className = `px-4 py-2 cursor-pointer font-mono text-sm border-b border-slate-700 last:border-0 ${
                isSelected ? 'bg-blue-600 text-white' : 'text-slate-300 hover:bg-slate-700 hover:text-white'
            }`;
            li.textContent = capitalize(match);
            
            li.addEventListener('click', (e) => {
                e.stopPropagation();
                selectPokemon(match);
            });
            els.ul.appendChild(li);
        });
        
        if (state.selectedIndex >= 0) {
            const selectedEl = els.ul.children[state.selectedIndex];
            if (selectedEl) {
                selectedEl.scrollIntoView({ block: 'nearest' });
            }
        }
    }

    function handleKeydown(e) {
        if (!state.isRoundActive) return;

        if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (state.currentMatches.length > 0) {
                state.selectedIndex = (state.selectedIndex + 1) % state.currentMatches.length;
                renderAutocomplete();
            }
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (state.currentMatches.length > 0) {
                state.selectedIndex = state.selectedIndex <= 0 ? state.currentMatches.length - 1 : state.selectedIndex - 1;
                renderAutocomplete();
            }
        } else if (e.key === 'Enter') {
            e.preventDefault();
            if (state.selectedIndex >= 0 && !els.ul.classList.contains('hidden')) {
                selectPokemon(state.currentMatches[state.selectedIndex]);
            } else {
                handleSubmit();
            }
        } else if (e.key === 'Escape') {
            closeAutocomplete();
        }
    }

    function selectPokemon(name) {
        els.input.value = capitalize(name);
        closeAutocomplete();
        els.input.focus();
    }

    function closeAutocomplete() {
        if(!els.ul) return;
        state.currentMatches = [];
        state.selectedIndex = -1;
        els.ul.innerHTML = '';
        els.ul.classList.add('hidden');
    }

    function handleSubmit() {
        if (!state.isRoundActive) return;
        const guess = els.input.value;
        if (!guess) return;

        const normalizedGuess = normalize(guess);
        const isValid = state.pokemonList.some(p => normalize(p) === normalizedGuess);
        
        if (!isValid) {
            els.input.classList.add('animate-shake');
            setTimeout(() => els.input.classList.remove('animate-shake'), 500);
            return;
        }
        const normalizedName = normalize(state.currentPokemon.name);

        if (normalizedGuess === normalizedName) {
            handleSuccess();
        } else {
             handleSkip();
             els.input.value = '';
             els.input.focus();
        }
    }

    function handleSuccess() {
        state.isRoundActive = false;
        state.streak++;
        if (state.streak > state.record) {
            state.record = state.streak;
            localStorage.setItem('pixelguess_record', state.record);
        }
        updateScoreboard();

        // Animate Reveal (Depixelate)
        const startRes = DIFFICULTY_LEVELS[state.currentLevelIndex].resolution;
        animateReveal(startRes, 300, 500); // Shortened animation to 500ms

        if (state.currentRoundIsShiny && els.shinyIndicator) {
            els.shinyIndicator.classList.remove('hidden');
        }

        // Success Visuals
        if (els.gameCard) {
            els.gameCard.classList.remove('border-slate-900');
            els.gameCard.classList.add('border-green-500');
        }

        showFeedback(`¡Es ${capitalize(state.currentPokemon.name)}!`, 'text-green-400');

        setTimeout(startRound, 2000); // Shorter wait before new round
    }

    function animateReveal(startRes, endRes, duration) {
        const startTime = performance.now();
        
        function step(now) {
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / duration, 1);
            
            // Ease In Cubic: Starts slow (pixelated), ends fast (clear). 
            // This prevents spending too much time in the "almost clear but shifting pixels" phase.
            const ease = Math.pow(progress, 3);
            
            const currentRes = startRes + (endRes - startRes) * ease;
            
            // Draw
            const w = Math.floor(currentRes);
            const h = Math.floor(currentRes);
            const size = 300;

            const offCanvas = document.createElement('canvas');
            offCanvas.width = w;
            offCanvas.height = h;
            const offCtx = offCanvas.getContext('2d');
            
            // Turn off smoothing to keep the pixelated aesthetic until the very end
            ctx.imageSmoothingEnabled = false; 
            offCtx.imageSmoothingEnabled = false;

            offCtx.drawImage(state.currentImg, 0, 0, w, h);
            ctx.clearRect(0, 0, size, size);
            ctx.drawImage(offCanvas, 0, 0, w, h, 0, 0, size, size);

            if (progress < 1) {
                requestAnimationFrame(step);
            } else {
                // Ensure final frame is perfect
                ctx.imageSmoothingEnabled = true;
                ctx.clearRect(0, 0, size, size);
                ctx.drawImage(state.currentImg, 0, 0, size, size);
            }
        }
        
        requestAnimationFrame(step);
    }

    function handleFailure() {
        state.isRoundActive = false;
        state.streak = 0;
        updateScoreboard();

        // Reveal animation on failure too
        const startRes = DIFFICULTY_LEVELS[state.currentLevelIndex].resolution;
        animateReveal(startRes, 300, 500); 

        // Show shiny if it was shiny
        if (state.currentRoundIsShiny && els.shinyIndicator) {
            els.shinyIndicator.classList.remove('hidden');
        }

        // Failure Visuals
        if (els.gameCard) {
            els.gameCard.classList.remove('border-slate-900');
            els.gameCard.classList.add('border-red-500');
        }

        showFeedback(`Era ${capitalize(state.currentPokemon.name)}`, 'text-red-400');
        
        setTimeout(startRound, 2500);
    }

    function showFeedback(text, colorClass) {
        els.feedbackText.textContent = text;
        els.feedbackText.className = `text-xl font-mono font-bold text-white px-6 py-4 bg-slate-900 border-4 border-white shadow-[8px_8px_0px_0px_rgba(0,0,0,0.5)] ${colorClass}`;
        els.feedback.classList.remove('hidden');
    }

    function updateScoreboard() {
        els.streak.textContent = state.streak;
        els.record.textContent = state.record;
    }

    init();
</script>
