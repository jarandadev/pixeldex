---
---
<div class="flex flex-col items-center w-full">
    
    <!-- Pokedex Main Wrapper (Canvas for Drop Shadow to unify shape) -->
    <div class="relative w-full max-w-[420px] filter drop-shadow-2xl">
        
        <!-- Main Body Chassis (Unified) -->
        <div class="relative bg-[#dc0a2d] rounded-3xl border-[4px] border-[#89061c] border-b-[8px] pt-10 pb-8 px-6 flex flex-col gap-6">

            <!-- Lens Header Section -->
            <div class="relative w-full flex items-start gap-6 -mt-4 mb-2 z-20">
                <!-- Main Blue Lens -->
                <div class="relative w-16 h-16 rounded-full bg-blue-500 border-[4px] border-white shadow-[0px_2px_4px_rgba(0,0,0,0.3)] overflow-hidden">
                    <div class="absolute top-1 left-2.5 w-4 h-4 bg-white rounded-full blur-[1px] z-10"></div>
                    <div class="absolute top-5 left-1.5 w-2 h-2 bg-white rounded-full blur-[1px] z-10"></div>
                    <div class="absolute top-[50%] left-[50%] w-8 h-8 bg-blue-700 rounded-full blur-[1px] -translate-x-1/2 -translate-y-1/2"></div>
                    <div class="absolute inset-0 rounded-full shadow-[inset_-3px_-3px_10px_rgba(0,0,0,0.2)]"></div>
                </div>

                <!-- Small LEDs -->
                <div class="flex gap-2 mt-2 mr-2">
                    <div class="relative w-4 h-4 rounded-full bg-red-500 border border-red-900 shadow-inner">
                        <div class="absolute top-0.5 left-0.5 w-1 h-1 bg-white rounded-full blur-[1px] z-10"></div>
                        <div class="absolute top-[50%] left-[50%] w-2 h-2 bg-red-700 rounded-full blur-[1px] -translate-x-1/2 -translate-y-1/2"></div>
                    </div>
                    <div class="relative w-4 h-4 rounded-full bg-yellow-500 border border-yellow-900 shadow-inner">
                        <div class="absolute top-0.5 left-0.5 w-1 h-1 bg-white rounded-full blur-[1px] z-10"></div>
                        <div class="absolute top-[50%] left-[50%] w-2 h-2 bg-yellow-700 rounded-full blur-[1px] -translate-x-1/2 -translate-y-1/2"></div>
                    </div>
                    <div class="relative w-4 h-4 rounded-full bg-green-500 border border-green-900 shadow-inner">
                        <div class="absolute top-0.5 left-0.5 w-1 h-1 bg-white rounded-full blur-[1px] z-10"></div>
                        <div class="absolute top-[50%] left-[50%] w-2 h-2 bg-green-700 rounded-full blur-[1px] -translate-x-1/2 -translate-y-1/2"></div>
                    </div>
                </div>
            </div>


            <!-- Screen Container (Bezel) -->
            <div class="bg-[#dedede] px-8 pt-3 pb-2 rounded rounded-bl-[40px] border-4 border-[#89061c] shadow-[inset_0_0_15px_rgba(0,0,0,0.1)]">
                
                <!-- Tiny Red Dots -->
                <div class="flex justify-center gap-3 mb-3">
                    <div class="w-2 h-2 bg-red-600 rounded-full shadow-sm"></div>
                    <div class="w-2 h-2 bg-red-600 rounded-full shadow-sm"></div>
                </div>

                <!-- The Screen -->
                <div id="game-card" class="relative bg-[#232323] border-4 border-[#4a4a4a] rounded shadow-inner overflow-hidden flex flex-col p-2 transition-colors duration-300">
                    
                    <!-- Stats Line -->
                    <div class="w-full flex justify-between items-center px-1 mb-1 pb-1">
                        <div class="flex flex-col leading-none">
                             <span class="text-[10px] text-green-500 font-mono tracking-wider opacity-70">STREAK</span>
                             <span id="current-streak" class="font-mono text-center text-green-500 text-lg">0</span>
                        </div>
                        <!-- Reveal Pokemon Name (Hidden by default) -->
                        <div id="reveal-name" class="hidden flex-col items-center leading-none max-w-[140px]">
                             <span id="reveal-label" class="text-[8px] font-mono tracking-wider opacity-70"></span>
                             <span id="reveal-pokemon" class="font-mono text-center text-sm font-bold uppercase truncate w-full"></span>
                        </div>
                        <div class="flex flex-col items-end leading-none">
                             <span class="text-[10px] text-yellow-500 font-mono tracking-wider opacity-70">RECORD</span>
                             <span id="record-streak" class="font-mono text-center text-yellow-500 w-full text-lg">0</span>
                        </div>
                    </div>

                    <!-- Canvas -->
                    <div class="relative w-full aspect-square bg-[#98c993] border-2 border-[#5a5a5a] shadow-inner mb-1 overflow-hidden">
                        <div class="absolute inset-0 z-0 opacity-30 pointer-events-none cyber-grid"></div>
                        <canvas id="game-canvas" width="300" height="300" class="relative z-10 w-full h-full object-contain image-rendering-pixelated"></canvas>
                        
                        <!-- Loading -->
                        <div id="loading-overlay" class="absolute inset-0 flex flex-col items-center justify-center bg-[#232323] z-20 gap-3">
                             <div class="pokeball-spinner"></div>
                             <div class="flex gap-1">
                                 <span class="loading-dot"></span>
                                 <span class="loading-dot" style="animation-delay: 0.2s"></span>
                                 <span class="loading-dot" style="animation-delay: 0.4s"></span>
                             </div>
                        </div>

                        <!-- Shiny Star -->
                        <div id="shiny-indicator" class="hidden absolute top-2 right-2 z-30">
                             <svg class="w-8 h-8 text-yellow-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        </div>
                    </div>
                </div>

                <div class="flex justify-between items-center gap-3 mt-2">
                    <div class="w-4 h-4 bg-red-600 rounded-full shadow-sm"></div>
                    <span>PIXELDEX v1.0</span>
                    <div class="space-y-1">
                        <div class="h-1 w-6 bg-[#5a5a5a] rounded-full"></div>
                        <div class="h-1 w-6 bg-[#5a5a5a] rounded-full"></div>
                        <div class="h-1 w-6 bg-[#5a5a5a] rounded-full"></div>
                    </div>
                </div>
            </div>
            

            <!-- Controls Deck -->
            <div class="flex gap-4 items-center justify-between">
                
                <!-- LEFT SECTION: Gen + Shiny Buttons (Stacked) -->
                <div class="flex flex-col gap-2 shrink-0">
                    
                    <!-- Gen Button (D-Pad Style) -->
                    <div class="relative" id="gen-dropdown-container">
                        <button id="gen-dropdown-btn" class="w-12 h-12 bg-[#333] rounded-full border-b-[3px] border-black flex items-center justify-center active:border-0 active:translate-y-1 transition-all cursor-pointer">
                            <span class="font-mono text-[12px] font-bold text-white">GEN</span>
                        </button>
                        
                        <!-- Dropdown -->
                        <div id="gen-dropdown-menu" class="absolute bottom-full left-0 mb-3 w-40 bg-[#98c993] border-4 border-[#333] p-1 hidden shadow-2xl z-50 rounded">
                            <div class="max-h-40 overflow-y-auto p-1 space-y-1">
                                <!-- Creating labels here for base structure, JS can append or use these -->
                            </div>
                        </div>
                    </div>

                    <!-- Shiny Button (D-Pad Style) -->
                    <button id="shiny-toggle" class="w-12 h-12 bg-[#333] rounded-full border-b-[3px] border-black flex items-center justify-center active:border-0 active:translate-y-1 transition-all cursor-pointer">
                        <!-- Star Icon -->
                        <svg id="shiny-icon" class="w-5 h-5 text-slate-400 transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    </button>
                    
                </div>

                <!-- CENTER SECTION: Skip + Submit + Input (Largest, Centered) -->
                <div class="flex-1 flex flex-col gap-2 max-w-[280px]">
                    
                    <!-- Skip and Submit Buttons Row -->
                    <div class="flex gap-2">
                        <!-- Skip Button (Red with counter) -->
                        <button id="skip-btn" class="flex-1 bg-red-500 h-12 rounded text-white font-mono text-[12px] font-bold border-b-[3px] border-red-900 active:border-0 active:translate-y-1 cursor-pointer transition-all flex items-center justify-center">
                            <span id="skip-btn-text">SKIP (4)</span>
                        </button>
                        
                        <!-- Submit Button (Blue) -->
                        <button id="submit-btn" class="flex-1 bg-blue-500 h-12 rounded text-white font-mono text-[12px] font-bold border-b-[3px] border-blue-900 active:border-0 active:translate-y-1 cursor-pointer transition-all">
                            SUBMIT
                        </button>
                    </div>
                    
                    <!-- Input Field -->
                    <div class="relative w-full group">
                        <input 
                            type="text" 
                            id="guess-input" 
                            class="w-full bg-[#98c993] text-[#232323] px-3 py-2 font-mono text-sm uppercase placeholder-[#5a7a57] border-4 border-[#5a5a5a] shadow-inner rounded outline-none focus:bg-[#aadda5] transition-colors tracking-wide"
                            placeholder="NAME..." 
                            autocomplete="off"
                        >
                        <ul id="autocomplete-list" class="absolute uppercase left-0 right-0 top-full mt-1 bg-[#98c993] border-4 border-[#5a5a5a] max-h-32 overflow-y-auto hidden z-50 shadow-xl rounded font-mono text-[#232323]"></ul>
                    </div>
                    
                </div>

<!-- RIGHT SECTION: D-Pad -->
                <div class="relative w-[60px] h-[60px] shrink-0">
                    <!-- Horizontal bar -->
                    <div class="absolute top-[20px] left-[3px] w-[54px] h-[20px] bg-[#333] rounded border-b-[2px] border-black"></div>
                    <!-- Vertical bar -->
                    <div class="absolute top-[3px] left-[20px] w-[20px] h-[54px] bg-[#333] rounded border-b-[2px] border-black"></div>
                    
                    <!-- Arrows (triángulos equiláteros) -->
                    <!-- Up Arrow -->
                    <svg class="absolute top-[7px] left-[25px] w-[10px] h-[10px] text-[#1a1a1a] opacity-50" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 4l10 17H2z"/>
                    </svg>
                    <!-- Down Arrow -->
                    <svg class="absolute bottom-[7px] left-[25px] w-[10px] h-[10px] text-[#1a1a1a] opacity-50" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 20L2 3h20z"/>
                    </svg>
                    <!-- Left Arrow -->
                    <svg class="absolute top-[25px] left-[7px] w-[10px] h-[10px] text-[#1a1a1a] opacity-50" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M4 12l17-10v20z"/>
                    </svg>
                    <!-- Right Arrow -->
                    <svg class="absolute top-[25px] right-[7px] w-[10px] h-[10px] text-[#1a1a1a] opacity-50" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M20 12L3 2v20z"/>
                    </svg>
                    
                    <!-- Center dent -->
                    <div class="absolute top-[26px] left-[26px] w-[8px] h-[8px] bg-[#1a1a1a] rounded-full opacity-50"></div>
                </div>

            </div>

        </div>

    </div>


</div>

<style>
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #8bac87; }
    ::-webkit-scrollbar-thumb { background: #5a7a57; border-radius: 3px;}

    .cyber-grid {
        background-size: 37.5px 37.5px;
        background-image:
            linear-gradient(to right, rgba(0, 0, 0, 0.25) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(0, 0, 0, 0.25) 1px, transparent 1px);
        animation: moveCyberGrid 8s linear infinite;
    }

    @keyframes moveCyberGrid {
        0% { background-position: 0 0; }
        100% { background-position: 37.5px -37.5px; }
    }

    .image-rendering-pixelated { image-rendering: pixelated; }

    @keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-4px); }
        75% { transform: translateX(4px); }
    }
    .animate-shake { animation: shake 0.3s ease-in-out; }

    /* Pokeball Spinner Animation */
    .pokeball-spinner {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: linear-gradient(to bottom, #dc0a2d 0%, #dc0a2d 50%, #fff 50%, #fff 100%);
        position: relative;
        animation: spin 1s linear infinite;
        border: 3px solid #232323;
    }
    
    .pokeball-spinner::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 14px;
        height: 14px;
        background: #fff;
        border: 3px solid #232323;
        border-radius: 50%;
        z-index: 2;
    }
    
    .pokeball-spinner::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        height: 3px;
        background: #232323;
        transform: translateY(-50%);
        z-index: 1;
    }
    
    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    
    /* Loading Dots */
    .loading-dot {
        width: 6px;
        height: 6px;
        background: #4af626;
        border-radius: 50%;
        display: inline-block;
        animation: dotPulse 1.4s infinite ease-in-out both;
    }
    
    @keyframes dotPulse {
        0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
        40% { opacity: 1; transform: scale(1.2); }
    }

    /* Button Active States (Applied by JS) */
    .btn-active-gold {
        background-color: #422006 !important; /* Dark Brown/Gold bg */
        border-color: #fcc800 !important; /* Yellow-500 */
    }
</style>

<script>
    const GEN_RANGES = {
        'gen1': { min: 1, max: 151 },
        'gen2': { min: 152, max: 251 },
        'gen3': { min: 252, max: 386 },
        'gen4': { min: 387, max: 493 },
        'gen5': { min: 494, max: 649 },
        'gen6': { min: 650, max: 721 },
        'gen7': { min: 722, max: 809 },
        'gen8': { min: 810, max: 905 },
        'gen9': { min: 906, max: 1025 }
    };

    const DIFFICULTY_LEVELS = [
        { level: 4, resolution: 8, label: "Extremo" },
        { level: 3, resolution: 10, label: "Difícil" },
        { level: 2, resolution: 12, label: "Medio" },
        { level: 1, resolution: 16, label: "Fácil" }
    ];

    // State
    let state = {
        currentPokemon: null,
        currentImg: null,
        currentLevelIndex: 0, 
        isLoading: false,
        streak: 0,
        record: parseInt(localStorage.getItem('pixelguess_record') || '0'),
        pokemonList: [],
        currentMatches: [],
        selectedIndex: -1,
        isRoundActive: true,
        // Settings
        isShinyMode: false, 
        currentRoundIsShiny: false, 
        selectedGens: new Set(['gen1', 'gen2', 'gen3', 'gen4', 'gen5', 'gen6', 'gen7', 'gen8', 'gen9'])
    };

    // Elements
    const els = {
        canvas: document.getElementById('game-canvas'),
        input: document.getElementById('guess-input'),
        skipBtn: document.getElementById('skip-btn'),
        skipBtnText: document.getElementById('skip-btn-text'),
        submitBtn: document.getElementById('submit-btn'),
        streak: document.getElementById('current-streak'),
        record: document.getElementById('record-streak'),
        loading: document.getElementById('loading-overlay'),
        ul: document.getElementById('autocomplete-list'),
        revealName: document.getElementById('reveal-name'),
        revealLabel: document.getElementById('reveal-label'),
        revealPokemon: document.getElementById('reveal-pokemon'),
        genBtn: document.getElementById('gen-dropdown-btn'),
        genMenu: document.getElementById('gen-dropdown-menu'),
        checkboxes: [], 
        shinyToggle: document.getElementById('shiny-toggle'),
        shinyIndicator: document.getElementById('shiny-indicator'),
        gameCard: document.getElementById('game-card')
    };

    const ctx = els.canvas.getContext('2d');
    const normalize = (str) => str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
    const capitalize = (s) => s.charAt(0).toUpperCase() + s.slice(1);

    function initGenOptions() {
        // Re-generate the Gen Checklist inside genMenu
        const container = els.genMenu.querySelector('div');
        container.innerHTML = ''; 
        
        const gens = [
            { id: 'gen1', label: 'GEN 1 (KANTO)' },
            { id: 'gen2', label: 'GEN 2 (JOHTO)' },
            { id: 'gen3', label: 'GEN 3 (HOENN)' },
            { id: 'gen4', label: 'GEN 4 (SINNOH)' },
            { id: 'gen5', label: 'GEN 5 (UNOVA)' },
            { id: 'gen6', label: 'GEN 6 (KALOS)' },
            { id: 'gen7', label: 'GEN 7 (ALOLA)' },
            { id: 'gen8', label: 'GEN 8 (GALAR)' },
            { id: 'gen9', label: 'GEN 9 (PALDEA)' },
        ];

        gens.forEach(g => {
            const label = document.createElement('label');
            label.className = "flex items-center space-x-2 p-2 hover:bg-[#8bac87] cursor-pointer text-[#232323] font-mono text-[10px] border-b border-[#8bac87] last:border-0";
            
            const checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.value = g.id;
            checkbox.checked = state.selectedGens.has(g.id);
            checkbox.className = "form-checkbox h-3 w-3 text-black rounded-none border-black focus:ring-0 accent-black"; 
            
            checkbox.addEventListener('change', (e) => {
                const val = e.target.value;
                if (e.target.checked) {
                    state.selectedGens.add(val);
                } else {
                    state.selectedGens.delete(val);
                }
                if (state.selectedGens.size === 0) {
                    e.target.checked = true;
                    state.selectedGens.add(val);
                    return; 
                }
                updateGenButtonVisuals();
                state.streak = 0;
                updateScoreboard();
                startRound();
            });

            const span = document.createElement('span');
            span.textContent = g.label;
            
            label.appendChild(checkbox);
            label.appendChild(span);
            container.appendChild(label);
        });
    }

    async function init() {
        initGenOptions();
        updateScoreboard();
        updateGenButtonVisuals();
        
        try {
            const res = await fetch('https://pokeapi.co/api/v2/pokemon?limit=1025');
            const data = await res.json();
            state.pokemonList = data.results.map(p => p.name);
        } catch (e) {
            console.error("Failed to load pokemon list", e);
        }

        startRound();
        
        // Listeners
        els.skipBtn.addEventListener('click', handleSkip);
        els.submitBtn.addEventListener('click', handleSubmit);
        els.input.addEventListener('input', handleInput);
        els.input.addEventListener('keydown', handleKeydown);

        document.addEventListener('click', (e) => {
            if (e.target !== els.input && e.target !== els.ul) {
                closeAutocomplete();
            }
            if (els.genMenu && !document.getElementById('gen-dropdown-container').contains(e.target)) {
                els.genMenu.classList.add('hidden');
            }
        });

        els.genBtn.addEventListener('click', () => {
             els.genMenu.classList.toggle('hidden');
        });

        els.shinyToggle.addEventListener('click', () => {
            state.isShinyMode = !state.isShinyMode;
            updateShinyButtonVisuals();
            state.streak = 0;
            updateScoreboard();
            startRound();
        });
    }
    
    function updateGenButtonVisuals() {
        const count = state.selectedGens.size;
        const text = count === 9 ? 'GEN' : `G(${count})`;
        const span = els.genBtn.querySelector('span');
        span.textContent = text;
        
        // If all selected = Gold style text
        if (count === 9) {
             span.classList.remove('text-slate-500');
             span.classList.add('text-yellow-500');
        } else {
             span.classList.add('text-slate-500');
             span.classList.remove('text-yellow-500');
        }
    }

    function updateShinyButtonVisuals() {
        const icon = document.getElementById('shiny-icon');
        const line = document.getElementById('shiny-label-line');
        
        if (state.isShinyMode) {
            icon.classList.remove('text-slate-400');
            icon.classList.add('text-yellow-500'); 
        } else {
            icon.classList.add('text-slate-400');
            icon.classList.remove('text-yellow-500');
        }
    }

    function getRandomPokemonId() {
        let ranges = [];
        state.selectedGens.forEach(gen => {
            if (GEN_RANGES[gen]) ranges.push(GEN_RANGES[gen]);
        });
        if (ranges.length === 0) ranges.push(GEN_RANGES['gen1']);

        const total = ranges.reduce((acc, r) => acc + (r.max - r.min + 1), 0);
        let random = Math.floor(Math.random() * total);
        
        for (const r of ranges) {
            const span = r.max - r.min + 1;
            if (random < span) return r.min + random;
            random -= span;
        }
        return 1; 
    }

    async function startRound() {
        if (state.isLoading) return;
        state.isLoading = true;
        state.isRoundActive = true;
        
        els.input.value = '';
        els.input.disabled = true;
        els.skipBtn.disabled = true;
        els.submitBtn.disabled = true;
        closeAutocomplete();
        
        els.loading.classList.remove('hidden');
        if(els.revealName) els.revealName.classList.add('hidden');
        if(els.shinyIndicator) els.shinyIndicator.classList.add('hidden');

        // Card colors remain unchanged
        
        state.currentLevelIndex = 0;
        updateGuessesText();

        const randomId = getRandomPokemonId();
        
        try {
            const res = await fetch(`https://pokeapi.co/api/v2/pokemon/${randomId}`);
            const data = await res.json();

            let isShinyRound = false;
            if (state.isShinyMode) {
                isShinyRound = Math.random() < 0.5;
            }
            state.currentRoundIsShiny = isShinyRound;

            let imgUrl = data.sprites.other['official-artwork'].front_default || data.sprites.front_default;
            if (state.currentRoundIsShiny) {
                const shinyUrl = data.sprites.other['official-artwork'].front_shiny || data.sprites.front_shiny;
                if (shinyUrl) imgUrl = shinyUrl;
                else state.currentRoundIsShiny = false;
            }

            state.currentPokemon = { name: data.name, imgUrl: imgUrl };

            const img = new Image();
            img.crossOrigin = "Anonymous";
            img.src = state.currentPokemon.imgUrl;
            
            await new Promise((resolve, reject) => {
                img.onload = resolve;
                img.onerror = reject;
            });
            
            state.currentImg = img;
            renderLevel();
            
            state.isLoading = false;
            els.loading.classList.add('hidden');
            els.input.disabled = false;
            els.skipBtn.disabled = false;
            els.submitBtn.disabled = false;
            els.input.focus();
            
        } catch (e) {
            console.error(e);
            state.isLoading = false; 
            setTimeout(startRound, 1000);
        }
    }

    function renderLevel() {
        if (!state.currentImg) return;
        const diff = DIFFICULTY_LEVELS[state.currentLevelIndex];
        const size = 300;
        ctx.imageSmoothingEnabled = false;
        const w = diff.resolution;
        const h = diff.resolution;
        
        const offCanvas = document.createElement('canvas');
        offCanvas.width = w;
        offCanvas.height = h;
        const offCtx = offCanvas.getContext('2d');
        offCtx.clearRect(0, 0, w, h);
        offCtx.drawImage(state.currentImg, 0, 0, w, h);
        
        ctx.clearRect(0, 0, size, size);
        ctx.drawImage(offCanvas, 0, 0, w, h, 0, 0, size, size);
    }

    function handleSkip() {
        if (!state.isRoundActive || state.isLoading) return;
        
        if (state.currentLevelIndex < DIFFICULTY_LEVELS.length - 1) {
            state.currentLevelIndex++;
            renderLevel();
            updateGuessesText();
        } else {
            // Ya estamos en el último nivel, ejecutar failure
            handleFailure();
        }
        els.input.focus();
    }

    function updateGuessesText() {
        // Calcular cuántos niveles quedan DESPUÉS del actual
        const remaining = DIFFICULTY_LEVELS.length - state.currentLevelIndex - 1;
        if(els.skipBtnText) els.skipBtnText.textContent = `SKIP (${remaining})`;
    }
    function handleInput(e) {
        if (!state.isRoundActive) return;
        const val = e.target.value;
        if (!val || val.length < 2) {
            closeAutocomplete();
            return;
        }
        const normVal = normalize(val);
        state.currentMatches = state.pokemonList
            .filter(name => normalize(name).includes(normVal))
            .slice(0, 50);

        if (state.currentMatches.length > 0) {
            state.selectedIndex = -1;
            renderAutocomplete();
            els.ul.classList.remove('hidden');
        } else {
            closeAutocomplete();
        }
    }

    function renderAutocomplete() {
        els.ul.innerHTML = '';
        state.currentMatches.forEach((match, index) => {
            const li = document.createElement('li');
            const isSelected = index === state.selectedIndex;
            // Retro style matching
            li.className = `px-4 py-2 cursor-pointer font-mono text-xs border-b border-[#5a7a57] last:border-0 ${
                isSelected ? 'bg-[#5a7a57] text-[#232323]' : 'text-[#232323] hover:bg-[#8bac87]'
            }`;
            li.textContent = capitalize(match);
            li.addEventListener('click', (e) => {
                e.stopPropagation();
                selectPokemon(match);
            });
            els.ul.appendChild(li);
        });
        if (state.selectedIndex >= 0) {
            els.ul.children[state.selectedIndex]?.scrollIntoView({ block: 'nearest' });
        }
    }

    function handleKeydown(e) {
        if (!state.isRoundActive) return;
        if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (state.currentMatches.length > 0) {
                state.selectedIndex = (state.selectedIndex + 1) % state.currentMatches.length;
                renderAutocomplete();
            }
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (state.currentMatches.length > 0) {
                state.selectedIndex = state.selectedIndex <= 0 ? state.currentMatches.length - 1 : state.selectedIndex - 1;
                renderAutocomplete();
            }
        } else if (e.key === 'Enter') {
            e.preventDefault();
            if (state.selectedIndex >= 0 && !els.ul.classList.contains('hidden')) {
                selectPokemon(state.currentMatches[state.selectedIndex]);
            } else {
                handleSubmit();
            }
        } else if (e.key === 'Escape') {
            closeAutocomplete();
        }
    }

    function selectPokemon(name) {
        els.input.value = capitalize(name);
        closeAutocomplete();
        els.input.focus();
    }

    function closeAutocomplete() {
        if(!els.ul) return;
        state.currentMatches = [];
        state.selectedIndex = -1;
        els.ul.innerHTML = '';
        els.ul.classList.add('hidden');
    }

    function handleSubmit() {
        if (!state.isRoundActive) return;
        const guess = els.input.value;
        if (!guess) return;
        const normalizedGuess = normalize(guess);
        const isValid = state.pokemonList.some(p => normalize(p) === normalizedGuess);
        if (!isValid) {
            els.input.parentElement.classList.add('animate-shake'); 
            setTimeout(() => els.input.parentElement.classList.remove('animate-shake'), 300);
            return;
        }
        const normalizedName = normalize(state.currentPokemon.name);
        if (normalizedGuess === normalizedName) {
            handleSuccess();
        } else {
             handleSkip();
             els.input.value = '';
             els.input.focus();
        }
    }

    function handleSuccess() {
        state.isRoundActive = false;
        state.streak++;
        if (state.streak > state.record) {
            state.record = state.streak;
            localStorage.setItem('pixelguess_record', state.record);
        }
        updateScoreboard();
        
        const startRes = DIFFICULTY_LEVELS[state.currentLevelIndex].resolution;
        animateReveal(startRes, 300, 500);

        if (state.currentRoundIsShiny && els.shinyIndicator) {
            els.shinyIndicator.classList.remove('hidden');
        }

        // Success Visuals - Show name at top in green
        showRevealName(state.currentPokemon.name, true);
        setTimeout(startRound, 2000);
    }

    function animateReveal(startRes, endRes, duration) {
        const startTime = performance.now();
        function step(now) {
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const ease = Math.pow(progress, 3);
            const currentRes = startRes + (endRes - startRes) * ease;
            const w = Math.floor(currentRes);
            const h = Math.floor(currentRes);
            const size = 300;

            const offCanvas = document.createElement('canvas');
            offCanvas.width = w;
            offCanvas.height = h;
            const offCtx = offCanvas.getContext('2d');
            ctx.imageSmoothingEnabled = false; 
            offCtx.imageSmoothingEnabled = false;

            offCtx.drawImage(state.currentImg, 0, 0, w, h);
            ctx.clearRect(0, 0, size, size);
            ctx.drawImage(offCanvas, 0, 0, w, h, 0, 0, size, size);

            if (progress < 1) {
                requestAnimationFrame(step);
            } else {
                ctx.imageSmoothingEnabled = true;
                ctx.clearRect(0, 0, size, size);
                ctx.drawImage(state.currentImg, 0, 0, size, size);
            }
        }
        requestAnimationFrame(step);
    }

    function handleFailure() {
        state.isRoundActive = false;
        state.streak = 0;
        updateScoreboard();

        const startRes = DIFFICULTY_LEVELS[state.currentLevelIndex].resolution;
        animateReveal(startRes, 300, 500); 

        if (state.currentRoundIsShiny && els.shinyIndicator) {
            els.shinyIndicator.classList.remove('hidden');
        }

        // Failure Visuals - Show name at top in red
        showRevealName(state.currentPokemon.name, false);
        setTimeout(startRound, 2500);
    }

    function showRevealName(pokemonName, isSuccess) {
        if (!els.revealName || !els.revealLabel || !els.revealPokemon) return;
        
        // const label = isSuccess ? 'CORRECT!' : 'FAILED!';
        const colorClass = isSuccess ? 'text-green-500' : 'text-red-500';
        
        // els.revealLabel.textContent = label;
        els.revealLabel.className = `text-[10px] font-mono tracking-wider opacity-70 ${colorClass}`;
        els.revealPokemon.textContent = capitalize(pokemonName);
        els.revealPokemon.className = `font-mono text-center text-md font-bold uppercase truncate w-full ${colorClass}`;
        els.revealName.classList.remove('hidden');
        els.revealName.classList.add('flex');
    }

    function updateScoreboard() {
        els.streak.textContent = state.streak;
        els.record.textContent = state.record;
    }

    init();
</script>
