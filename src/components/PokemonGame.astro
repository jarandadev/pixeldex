<div class="flex flex-col items-center w-full">
    
    <!-- Pokedex Main Wrapper (Canvas for Drop Shadow to unify shape) -->
    <div class="relative w-full max-w-[550px] filter drop-shadow-2xl">
        
        <!-- Main Body Chassis (Unified) -->
        <div class="relative bg-[#dc0a2d] rounded-3xl border-[4px] border-[#89061c] border-b-[8px] pt-10 pb-8 px-6 flex flex-col gap-6">

            <!-- Lens Header Section -->
            <div class="relative w-full flex items-start gap-4 -mt-4 mb-2 z-20">
                <!-- Main Blue Lens -->
                <div class="relative w-20 h-20 rounded-full bg-blue-500 border-[4px] border-white overflow-hidden shrink-0">
                    <div class="absolute top-1.5 left-2.5 w-4 h-4 bg-white rounded-full blur-[1px] z-10 opacity-80"></div>
                    <div class="absolute top-6 left-2 w-2 h-2 bg-white rounded-full blur-[1px] z-10 opacity-40"></div>
                    <div class="absolute top-[50%] left-[50%] w-10 h-10 bg-blue-400 rounded-full blur-[4px] -translate-x-1/2 -translate-y-1/2 opacity-30"></div>
                    <div class="absolute inset-0 shadow-[inset_-4px_-4px_18px_rgba(0,0,0,0.2)]"></div>
                </div>

                <!-- Small LEDs -->
                <div class="flex gap-2.5 mt-2">
                    <!-- Red Indicator (Hide Sprites) -->
                    <div class="relative w-5 h-5 rounded-full bg-[#1a1a1a] border-2 border-white overflow-hidden shrink-0">
                        <div class="absolute inset-0 bg-red-500 opacity-100" id="indicator-sprites-light"></div>
                        <div class="absolute top-0.5 left-0.5 w-1 h-1 bg-white rounded-full blur-[0.5px] z-10 opacity-80"></div>
                        <div class="absolute inset-0 shadow-[inset_-1px_-1px_3px_rgba(0,0,0,0.2)]"></div>
                    </div>
                    <!-- Yellow Indicator (Shiny Chance) -->
                    <div class="relative w-5 h-5 rounded-full bg-[#1a1a1a] border-2 border-white overflow-hidden shrink-0">
                        <div class="absolute inset-0 bg-yellow-400 opacity-100" id="indicator-shiny-light"></div>
                        <div class="absolute top-0.5 left-0.5 w-1 h-1 bg-white rounded-full blur-[0.5px] z-10 opacity-80"></div>
                        <div class="absolute inset-0 shadow-[inset_-1px_-1px_3px_rgba(0,0,0,0.2)]"></div>
                    </div>
                    <!-- Green Indicator (All Generations) -->
                    <div class="relative w-5 h-5 rounded-full bg-[#1a1a1a] border-2 border-white overflow-hidden shrink-0">
                        <div class="absolute inset-0 bg-green-500 opacity-100" id="indicator-gens-light"></div>
                        <div class="absolute top-0.5 left-0.5 w-1 h-1 bg-white rounded-full blur-[0.5px] z-10 opacity-80"></div>
                        <div class="absolute inset-0 shadow-[inset_-1px_-1px_3px_rgba(0,0,0,0.2)]"></div>
                    </div>
                </div>
            </div>


            <!-- Screen Container (Bezel) -->
            <div class="bg-[#dedede] px-8 pt-3 pb-2 rounded rounded-bl-[40px] border-4 border-[#89061c] shadow-[inset_0_0_15px_rgba(0,0,0,0.1)]">
                
                <!-- Tiny Red Dots -->
                <div class="flex justify-center gap-3 mb-3">
                    <div class="w-2 h-2 bg-red-600 rounded-full"></div>
                    <div class="w-2 h-2 bg-red-600 rounded-full"></div>
                </div>

                <!-- The Screen -->
                <div id="game-card" class="relative bg-[#232323] border-4 border-[#4a4a4a] rounded shadow-inner overflow-hidden flex flex-col p-2 transition-colors duration-300">
                    
                    <!-- Stats Line -->
                    <div class="w-full flex justify-between items-center px-1 pb-1">
                        <div class="flex flex-col leading-none">
                             <span class="text-xs text-[#dedede] font-mono tracking-wider opacity-70">STREAK</span>
                             <span id="current-streak" class="font-mono text-center text-[#dedede] text-lg">0</span>
                        </div>
                        <!-- Reveal Pokemon Name (Hidden by default) -->
                        <div id="reveal-name" class="hidden flex-col items-center leading-none max-w-[140px]">
                             <!-- <span id="reveal-label" class="text-[8px] font-mono tracking-wider opacity-70"></span> -->
                             <span id="reveal-pokemon" class="font-mono text-center text-sm font-bold uppercase truncate w-full"></span>
                        </div>
                        <div class="flex flex-col items-end leading-none">
                             <span class="text-xs text-[#dedede] font-mono tracking-wider opacity-70">BEST</span>
                             <span id="record-streak" class="font-mono text-center text-[#dedede] w-full text-lg">0</span>
                        </div>
                    </div>

                    <!-- Canvas -->
                    <div class="relative w-full aspect-square bg-[#98c993] border-2 border-[#5a5a5a] shadow-inner overflow-hidden">
                        <div class="absolute inset-0 z-0 opacity-30 pointer-events-none cyber-grid"></div>
                        <canvas id="game-canvas" width="300" height="300" class="relative z-10 w-full h-full object-contain image-rendering-pixelated"></canvas>
                        
                        <!-- Loading -->
                        <div id="loading-overlay" class="absolute inset-0 flex flex-col items-center justify-center bg-[#232323] z-20 gap-3">
                             <div class="pokeball-spinner"></div>
                             <div class="flex gap-1">
                                 <span class="loading-dot"></span>
                                 <span class="loading-dot" style="animation-delay: 0.2s"></span>
                                 <span class="loading-dot" style="animation-delay: 0.4s"></span>
                             </div>
                        </div>

                        <!-- Shiny Star -->
<div id="shiny-indicator" class="absolute top-2 right-2 z-30">
